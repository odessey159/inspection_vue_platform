# Core runtime directories
APP_HOME=/app
RUNTIME_DIR=/app/.runtime
PROJECTS_DIR=/app/.runtime/projects
DATABASE_PATH=/app/.runtime/inspection.db
# In-container path. Host directory is mounted via INPUTS_HOST_DIR (docker-compose).
INPUTS_DIR=/app/inputs
# Host path mounted at /app/inputs. Local bulky data lives next to the repo:
# INPUTS_HOST_DIR=../data/inputs
INPUTS_HOST_DIR=./inputs
CONFIG_DIR=/app/config
ROSENV_DIR=/app/backend/rosenv
DEFAULT_STANDARDS_DIR=/app/inputs/standards
SECURITY_CHECK_CALIBRATION_PATH=/app/config/security_check.yaml
DISCOVERY_ROOTS=/app/inputs,/app

# Network
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8700,http://localhost:8700

# External tools
FFMPEG_BIN=ffmpeg
COLMAP_BIN=

# Multimodal provider
VISION_PROVIDER=dashscope
VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.5-plus
VISION_CLIP_SECONDS=25
VISION_VIDEO_FPS=1
VISION_MAX_CLIP_BYTES=7340032
VISION_MAX_FINDINGS_PER_CLIP=4
VISION_MAX_RETRIES=2
VISION_REQUEST_TIMEOUT_SECONDS=120
VISION_TEMPERATURE=0.1
VISION_ENABLE_THINKING=false

# Self-hosted YOLO detector (runs before provider LLM)
# Docker Compose: host.docker.internal (YOLO runs on the host, not inside the container)
# Local backend: http://127.0.0.1:8001 (see backend/.env.example)
YOLO_API_URL=http://host.docker.internal:8001
YOLO_API_KEY=
YOLO_DETECT_PATH=/predict/video
YOLO_RTSP_DETECT_PATH=/predict/rtsp
YOLO_RTSP_DEFAULT_DURATION_SEC=60
YOLO_RTSP_MAX_DURATION_SEC=600
YOLO_RTSP_SEGMENT_SECONDS=10
YOLO_RTSP_TRANSPORT=tcp
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_MAX_RETRIES=2
YOLO_REQUEST_TIMEOUT_SECONDS=180
YOLO_FAIL_OPEN=false
# quad (default): split each decoded frame into 2x2 tiles and run YOLO on each crop.
# full: previous whole-frame YOLO path (optional fallback).
YOLO_FRAME_LAYOUT=quad
YOLO_QUAD_TILE_LABELS=front,rear,left,right
YOLO_SAME_TIME_DEDUPE_WINDOW_MS=2000

# YOLO inference service (separate process on port 8001)
YOLO_WEIGHTS_PATH=backend/models/YOLO/security_check_540.pt
YOLO_IMGSZ=960
YOLO_CONFIDENCE=0.25
YOLO_SERVICE_HOST=127.0.0.1
YOLO_SERVICE_PORT=8001
YOLO_LOG_DIR=.runtime/YOLO_log
YOLO_EXPECTED_CLASSES=19

# Maximum wait for the first decodable RTSP frame (seconds).
RTSP_PUBLISH_PROBE_TIMEOUT_SECONDS=60
# RTSP timeline parser: sei (default, pose SEI then barcode fallback) or barcode.
RTSP_TIMELINE_PARSER=sei

# Rule RAG (optional; default off — keeps full-rule prompt behavior)
RULE_RAG_ENABLED=false
RULE_DB_PATH=/app/backend/data/rules.db
RULE_RETRIEVAL_TOP_K=20
RULE_RAG_FALLBACK_TOP_K=15
OBJECT_ALIASES_PATH=/app/backend/config/object_aliases.yaml

# Scene generation
SCENE_VOXEL_SIZE=0.08
SCENE_MAX_POINTS=600000
SCENE_MAX_SOURCE_FRAMES=0
SCENE_MAX_TRAJECTORY_SAMPLES=1500
SCENE_ROOF_QUANTILE=0.92
SCENE_FLOOR_CUT_QUANTILE=0.35
SCENE_FLOOR_CUT_MIN_LIFT=0.45
SCENE_FLOOR_CUT_MAX_LIFT=0.72
SCENE_LOW_OUTLIER_QUANTILE=0.01
SCENE_HIGH_OUTLIER_QUANTILE=0.995
SCENE_RENDER_TARGET_POINTS=600000
SCENE_RENDER_MAX_POINTS=600000
SCENE_CALIBRATION_SAMPLE_FRAMES=6
SCENE_CALIBRATION_SAMPLE_POINTS=1600
SCENE_EGO_FILTER_ENABLED=true
SCENE_EGO_FILTER_SAMPLE_FRAMES=160
SCENE_EGO_FILTER_VOXEL_SIZE=0.08
SCENE_EGO_FILTER_MIN_HIT_RATIO=0.08
SCENE_EGO_FILTER_EXPAND_CELLS=1
SCENE_EGO_FILTER_MIN_X=-1.55
SCENE_EGO_FILTER_MAX_X=1.55
SCENE_EGO_FILTER_MIN_Y=-1.05
SCENE_EGO_FILTER_MAX_Y=1.05
SCENE_EGO_FILTER_MIN_Z=-0.45
SCENE_EGO_FILTER_MAX_Z=1.35
SCENE_EGO_SWEEP_FILTER_ENABLED=true
SCENE_EGO_SWEEP_RADIUS=0.72
SCENE_EGO_SWEEP_MIN_Z_OFFSET=-0.35
SCENE_EGO_SWEEP_MAX_Z_OFFSET=1.15
SCENE_EGO_SWEEP_SAMPLE_COUNT=1200
CLIP_LENGTH_SECONDS=25
