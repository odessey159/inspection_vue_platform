# Local runtime (DB, recordings, robot maps, logs)
.runtime/

# Secrets and machine-local config
.env
.env.local
backend/.env
backend/.env.local
web/.env
web/.env.local
docker-compose.override.yml

# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend
node_modules/
dist/
web/.vite/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Generated logs and temp files
*.log
*.tmp

# Local databases and ROS bags (runtime/input data, not source).
