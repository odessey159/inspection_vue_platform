*.db
*.sqlite
*.sqlite3
*.db3
*.bag
*.mcap

# App extract/output dirs
output/
backend/extracted/
backend/scenes/
backend/summaries/
hazard_recognition_sample/outputs/

# Host input data (keep directory placeholders)
inputs/*
!inputs/.gitkeep
!inputs/standards/
inputs/standards/*
!inputs/standards/.gitkeep

# YOLO weights (large; place locally)
backend/models/**/*.pt
!backend/models/YOLO/.gitkeep

# IDE and local SSH key material
.idea/
id_rsa
id_rsa.pub
*.ppk
