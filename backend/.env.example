# Local bag/standards discovery. Default is <repo>/inputs.
# If rosbag/standards live outside the repo (sibling data/inputs), set for example:
# INPUTS_DIR=D:/important files/internship_file/3/data/inputs

VISION_PROVIDER=dashscope
VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=your-api-key
VISION_MODEL=qwen3.5-plus

YOLO_API_URL=http://127.0.0.1:8001
YOLO_API_KEY=
YOLO_DETECT_PATH=/predict/video
YOLO_RTSP_DETECT_PATH=/predict/rtsp
YOLO_RTSP_DEFAULT_DURATION_SEC=60
YOLO_RTSP_MAX_DURATION_SEC=600
YOLO_RTSP_SEGMENT_SECONDS=10
YOLO_RTSP_TRANSPORT=tcp
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_MAX_RETRIES=2
YOLO_REQUEST_TIMEOUT_SECONDS=180
YOLO_FAIL_OPEN=false
# quad (default): split each decoded frame into 2x2 tiles and run YOLO on each crop.
# full: previous whole-frame YOLO path (optional fallback).
YOLO_FRAME_LAYOUT=quad
YOLO_QUAD_TILE_LABELS=front,rear,left,right
# Collapse same-rule findings whose start times fall in this window (ms).
YOLO_SAME_TIME_DEDUPE_WINDOW_MS=2000
YOLO_WEIGHTS_PATH=backend/models/YOLO/security_check_540.pt
YOLO_IMGSZ=960
YOLO_CONFIDENCE=0.25
YOLO_SERVICE_HOST=127.0.0.1
YOLO_SERVICE_PORT=8001
YOLO_LOG_DIR=.runtime/YOLO_log
LLM_LOG_DIR=.runtime/LLM_log
YOLO_EXPECTED_CLASSES=19

# Rule RAG (on by default; set false to fall back to full-rule prompt behavior)
RULE_RAG_ENABLED=true
RULE_DB_PATH=backend/data/rules.db
RULE_RETRIEVAL_TOP_K=20
RULE_RAG_FALLBACK_TOP_K=15
OBJECT_ALIASES_PATH=backend/config/object_aliases.yaml
RTSP_VEHICLES_PATH=backend/config/rtsp_vehicles.yaml
# Frontend URL edits persist here (merged over the committed YAML).
RTSP_VEHICLES_OVERRIDE_PATH=.runtime/rtsp_vehicles.override.yaml
# Per-vehicle dirs: .runtime/robots/<id>/recordings
ROBOTS_DIR=.runtime/robots
# Standalone point-cloud catalog: .runtime/maps/<map_id>/ (vehicles store map_id only)
MAPS_DIR=.runtime/maps
RTSP_WATCH_ENABLED=true
RTSP_WATCH_POLL_INTERVAL_SECONDS=5
# Test mode: cap each recording at 10 minutes; when a vehicle already has more than 5 videos, delete the oldest before recording anew.
RTSP_WATCH_TEST_MODE=true
RTSP_WATCH_TEST_MAX_SECONDS=600
RTSP_WATCH_TEST_MAX_RECORDINGS=5
# Batch auto-analysis on RTSP connect (side path). Empty = disabled; prefer monitor LLM as the main live path.
RTSP_WATCH_AUTO_ANALYSIS_MODE=
# Continuous YOLO monitor: send each segment to the LLM via LangChain (main live path).
RTSP_YOLO_MONITOR_LLM_ENABLED=true
# Call LLM even when a segment has zero detections (default false to save cost).
RTSP_YOLO_MONITOR_LLM_ON_EMPTY=false
# Capture a short clip per segment for multimodal LLM review (cut from watchdog recording; RTSP -c copy fallback).
RTSP_YOLO_MONITOR_CAPTURE_CLIP=true
# RTSP timeline parser: sei (default, pose SEI then barcode fallback) or barcode.
RTSP_TIMELINE_PARSER=sei
# Live RTSP recording codec: copy (default, light) or libx264.
RTSP_RECORD_VIDEO_CODEC=copy
# ffmpeg RTSP socket I/O timeout (microseconds); passed as demuxer ``-timeout``.
RTSP_FFMPEG_RW_TIMEOUT_US=15000000
# Maximum wait for the first decodable frame when checking whether a publisher is online.
RTSP_PUBLISH_PROBE_TIMEOUT_SECONDS=60
